NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only. Never prefix these with NEXT_PUBLIC_ or place them in the Mac app.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_MANAGEMENT_CLIENT_ID=REPLACE_ME
SUPABASE_MANAGEMENT_CLIENT_SECRET=REPLACE_ME
CREDENTIAL_ENCRYPTION_KEY=BASE64_ENCODED_32_BYTE_KEY

# GitHub App installation flow and repository evidence.
GITHUB_APP_ID=REPLACE_ME
GITHUB_APP_SLUG=signalcase
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nREPLACE_ME\n-----END RSA PRIVATE KEY-----"
GITHUB_API_VERSION=2022-11-28
