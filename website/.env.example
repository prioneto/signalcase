NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only. Never prefix these with NEXT_PUBLIC_ or place them in the Mac app.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_MANAGEMENT_CLIENT_ID=REPLACE_ME
SUPABASE_MANAGEMENT_CLIENT_SECRET=REPLACE_ME
CREDENTIAL_ENCRYPTION_KEY=BASE64_ENCODED_32_BYTE_KEY

# GitHub App installation flow and repository evidence.
GITHUB_APP_ID=REPLACE_ME
GITHUB_APP_SLUG=signalcase
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nREPLACE_ME\n-----END RSA PRIVATE KEY-----"
GITHUB_API_VERSION=2022-11-28

# Stripe subscriptions. Create one recurring Team price and point the webhook
# at https://YOUR_DOMAIN/api/billing/webhook.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_TEAM_PRICE_ID=price_REPLACE_ME
BILLING_ENFORCEMENT_ENABLED=false
NEXT_PUBLIC_TEAM_PRICE_LABEL=YOUR PRICE / month

# Vercel Cron authenticates retention cleanup with this value.
CRON_SECRET=GENERATE_A_LONG_RANDOM_VALUE

# Add after the signed and notarized .dmg is hosted.
NEXT_PUBLIC_MAC_DOWNLOAD_URL=

# Release manifest served at /api/releases/latest and polled by the Mac app's
# update checker. Set both values every time a new build is published; keep
# them in sync with macOS/VERSION.
MAC_RELEASE_VERSION=0.1.0
MAC_RELEASE_BUILD=1
MAC_RELEASE_NOTES_URL=
