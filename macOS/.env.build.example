# Copy this file to .env.build and replace the three values once.
# .env.build is ignored by Git.

SIGNALCASE_CLOUD_URL=https://YOUR_DOMAIN
SIGNALCASE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SIGNALCASE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional for local builds. Use the exact Apple Development certificate name
# shown by: security find-identity -v -p codesigning
SIGNALCASE_CODESIGN_IDENTITY=
